# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Model configuration
LLM_MODEL_ID=your_model_id_here     # Model ID (e.g., gpt-4o, llama3, etc.)
LLM_API_BASE_URL=your_api_base_url  # For custom OpenAI-compatible APIs
LLM_TEMPERATURE=0.7                 # Model temperature (0.0 to 1.0)

# GitHub API Token (optional, for deeper repository analysis)
GITHUB_API_TOKEN=your_github_token_here
GITHUB_TOKEN=your_github_token_here